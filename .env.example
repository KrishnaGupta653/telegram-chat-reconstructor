# Copy to .env and fill in. Never commit .env.
# Get API_ID / API_HASH at https://my.telegram.org -> API development tools.
TG_API_ID=
TG_API_HASH=
# Telethon session file (kept local; default: WORK_DIR/telegram.session)
# TG_SESSION=work/telegram

# Telegram Desktop HTML export folder (only ever read)
EXPORT_DIR=C:\path\to\ChatExport_YYYY-MM-DD
# Generated DB, reports, chat files (must be outside EXPORT_DIR)
WORK_DIR=work

# Destination chat: @username or numeric id, e.g. the id printed by `python main.py create-group`
DESTINATION=

# Bracketed context notes for what the import cannot represent natively.
# Leave out "reactions" and "pins" if you will re-create them natively with `react` / `pin`.
ANNOTATE=replies,forwards,service,calls,ttl,albums
REPLY_QUOTE_CHARS=80
